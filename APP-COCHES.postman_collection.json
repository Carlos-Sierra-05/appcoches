      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Test 1: Verificar status code\r",
              "pm.test(\"✅ Status code es 200 (éxito) o 401 (credenciales incorrectas)\", function () {\r",
              "    pm.expect([200, 401, 429]).to.include(pm.response.code);\r",
              "});\r",
              "\r",
              "// Test 2: Verificar estructura de respuesta\r",
              "pm.test(\"✅ Respuesta tiene estructura correcta\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData).to.have.property('success');\r",
              "    pm.expect(jsonData).to.have.property('message');\r",
              "});\r",
              "\r",
              "// Test 3: Si login exitoso, verificar token\r",
              "if (pm.response.code === 200) {\r",
              "    pm.test(\"✅ Login exitoso - Token JWT recibido\", function () {\r",
              "        var jsonData = pm.response.json();\r",
              "        pm.expect(jsonData.success).to.be.true;\r",
              "        pm.expect(jsonData).to.have.property('token');\r",
              "        pm.expect(jsonData).to.have.property('usuario');\r",
              "        \r",
              "        // Verificar que el token tenga formato JWT (3 partes separadas por punto)\r",
              "        var token = jsonData.token;\r",
              "        pm.expect(token.split('.')).to.have.lengthOf(3);\r",
              "        \r",
              "        // Guardar token automáticamente\r",
              "        pm.environment.set('auth_token', jsonData.token);\r",
              "        pm.environment.set('user_email', jsonData.usuario.email);\r",
              "        pm.environment.set('user_rol', jsonData.usuario.rol);\r",
              "        pm.environment.set('user_id', jsonData.usuario.id);\r",
              "        pm.environment.set('user_nombre', jsonData.usuario.nombre);\r",
              "    });\r",
              "    \r",
              "    pm.test(\"✅ Datos de usuario completos\", function () {\r",
              "        var jsonData = pm.response.json();\r",
              "        var usuario = jsonData.usuario;\r",
              "        \r",
              "        pm.expect(usuario).to.have.property('id');\r",
              "        pm.expect(usuario).to.have.property('nombre');\r",
              "        pm.expect(usuario).to.have.property('email');\r",
              "        pm.expect(usuario).to.have.property('rol');\r",
