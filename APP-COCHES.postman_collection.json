        {
          "listen": "test",
          "script": {
            "exec": [
              "// Test 1: Verificar status code\r",
              "pm.test(\"✅ Status code es 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// Test 2: Verificar que la respuesta es JSON\r",
              "pm.test(\"✅ Respuesta es JSON\", function () {\r",
              "    pm.response.to.be.json;\r",
              "});\r",
              "\r",
              "// Test 3: Verificar estructura de la respuesta\r",
              "pm.test(\"✅ Respuesta tiene estructura correcta\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData).to.have.property('success');\r",
              "    pm.expect(jsonData).to.have.property('coches');\r",
              "    pm.expect(jsonData).to.have.property('total');\r",
              "    pm.expect(jsonData.success).to.be.true;\r",
              "});\r",
              "\r",
              "// Test 4: Verificar que TODOS los coches cuestan más de 20,000€\r",
              "pm.test(\"✅ Todos los coches cuestan MÁS de 20,000€\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    \r",
              "    if (jsonData.coches && jsonData.coches.length > 0) {\r",
              "        jsonData.coches.forEach(function(coche, index) {\r",
              "            pm.expect(coche.precio, `Coche ${index + 1} (${coche.marca} ${coche.modelo})`).to.be.above(20000);\r",
              "        });\r",
              "    } else {\r",
              "        console.log(\"⚠️ No se encontraron coches con ese precio\");\r",
              "    }\r",
              "});\r",
              "\r",
              "// Test 5: Verificar que están ordenados de mayor a menor precio\r",
              "pm.test(\"✅ Coches ordenados por precio DESCENDENTE\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    \r",
              "    if (jsonData.coches && jsonData.coches.length > 1) {\r",
              "        for (var i = 0; i < jsonData.coches.length - 1; i++) {\r",
              "            var precioActual = jsonData.coches[i].precio;\r",
              "            var precioSiguiente = jsonData.coches[i + 1].precio;\r",
              "            \r",
              "            pm.expect(precioActual, \r",
              "                `Precio del coche ${i + 1} (${precioActual}€) >= Precio del coche ${i + 2} (${precioSiguiente}€)`\r",
              "            ).to.be.at.least(precioSiguiente);\r",
              "        }\r",
              "    }\r",
              "});\r",
              "\r",
              "// Test 6: Verificar que tiene campos obligatorios cada coche\r",
              "pm.test(\"✅ Cada coche tiene campos obligatorios\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    \r",
              "    if (jsonData.coches && jsonData.coches.length > 0) {\r",
              "        jsonData.coches.forEach(function(coche) {\r",
              "            pm.expect(coche).to.have.property('id');\r",
              "            pm.expect(coche).to.have.property('marca');\r",
              "            pm.expect(coche).to.have.property('modelo');\r",
              "            pm.expect(coche).to.have.property('año');\r",
              "            pm.expect(coche).to.have.property('precio');\r",
              "        });\r",
              "    }\r",
              "});\r",
              "\r",
              "// ============================================\r",
              "// LOGS EN CONSOLA (Ver resultados detallados)\r",
              "// ============================================\r",
              "\r",
              "console.log(\"=\".repeat(60));\r",
              "console.log(\"🚗 COCHES MÁS CAROS DE 20,000€\");\r",
              "console.log(\"=\".repeat(60));\r",
              "\r",
              "var jsonData = pm.response.json();\r",
              "\r",
              "console.log(`\\n📊 Total encontrados: ${jsonData.total} coches\\n`);\r",
              "\r",
              "if (jsonData.coches && jsonData.coches.length > 0) {\r",
              "    jsonData.coches.forEach(function(coche, index) {\r",
              "        console.log(`${index + 1}. ${coche.marca} ${coche.modelo} (${coche.año})`);\r",
              "        console.log(`   💰 Precio: ${coche.precio.toLocaleString('es-ES')}€`);\r",
              "        console.log(`   📝 ${coche.descripcion || 'Sin descripción'}`);\r",
              "        console.log(\"\");\r",
              "    });\r",
              "    \r",
              "    // Calcular estadísticas\r",
              "    var precios = jsonData.coches.map(c => c.precio);\r",
              "    var precioMax = Math.max(...precios);\r",
              "    var precioMin = Math.min(...precios);\r",
              "    var precioPromedio = precios.reduce((a, b) => a + b, 0) / precios.length;\r",
              "    \r",
              "    console.log(\"📈 ESTADÍSTICAS:\");\r",
              "    console.log(`   • Más caro: ${precioMax.toLocaleString('es-ES')}€`);\r",
              "    console.log(`   • Más barato: ${precioMin.toLocaleString('es-ES')}€`);\r",
              "    console.log(`   • Precio promedio: ${precioPromedio.toLocaleString('es-ES')}€`);\r",
              "} else {\r",
              "    console.log(\"⚠️ No se encontraron coches con precio mayor a 20,000€\");\r",
              "}\r",
              "\r",
              "console.log(\"=\".repeat(60));\r",
              "```\r",
              "\r",
              "---\r",
              "\r",
