              "\r",
              "// Test 4: Si login falló\r",
              "if (pm.response.code === 401) {\r",
              "    pm.test(\"⚠️ Login fallido - Credenciales incorrectas\", function () {\r",
              "        var jsonData = pm.response.json();\r",
              "        pm.expect(jsonData.success).to.be.false;\r",
