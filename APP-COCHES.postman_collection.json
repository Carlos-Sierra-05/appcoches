              "    console.log(\"   • user_email:\", jsonData.usuario.email);\r",
              "    console.log(\"   • user_rol:\", jsonData.usuario.rol);\r",
              "    console.log(\"   • user_id:\", jsonData.usuario.id);\r",
              "    \r",
              "    console.log(\"\\n💡 Ahora puedes usar el token en otros requests\");\r",
              "    console.log(\"   Header: Authorization: Bearer {{auth_token}}\");\r",
              "    \r",
              "    // Decodificar payload del JWT (sin verificar firma)\r",
              "    try {\r",
              "        var base64Url = jsonData.token.split('.')[1];\r",
              "        var base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');\r",
              "        var payload = JSON.parse(atob(base64));\r",
              "        \r",
              "        console.log(\"\\n🔍 INFO DEL TOKEN:\");\r",
              "        console.log(\"   • Expira:\", new Date(payload.exp * 1000).toLocaleString('es-ES'));\r",
              "        console.log(\"   • Emitido:\", new Date(payload.iat * 1000).toLocaleString('es-ES'));\r",
              "        console.log(\"   • Válido por:\", Math.round((payload.exp - payload.iat) / 3600), \"horas\");\r",
              "    } catch (e) {\r",
              "        console.log(\"\\n⚠️ No se pudo decodificar el token\");\r",
              "    }\r",
              "    \r",
              "} else if (pm.response.code === 401) {\r",
              "    console.log(\"\\n❌ LOGIN FALLIDO\\n\");\r",
              "    console.log(\"📧 Email intentado:\", requestBody.email);\r",
              "    console.log(\"📝 Motivo:\", jsonData.message);\r",
              "    \r",
              "    console.log(\"\\n💡 Posibles causas:\");\r",
              "    console.log(\"   • Email incorrecto\");\r",
              "    console.log(\"   • Contraseña incorrecta\");\r",
              "    console.log(\"   • Usuario no existe\");\r",
              "    \r",
              "    // Si hay info de intentos restantes\r",
              "    if (jsonData.message.includes('quedan')) {\r",
              "        console.log(\"\\n⚠️ ATENCIÓN: Intentos restantes antes de bloqueo\");\r",
              "    }\r",
              "    \r",
              "} else if (pm.response.code === 429) {\r",
              "    console.log(\"\\n🔒 CUENTA BLOQUEADA\\n\");\r",
              "    console.log(\"📧 Email:\", requestBody.email);\r",
              "    console.log(\"📝 Motivo:\", jsonData.message);\r",
              "    console.log(\"\\n💡 Espera 15 minutos e intenta de nuevo\");\r",
              "    \r",
              "} else if (pm.response.code === 400) {\r",
              "    console.log(\"\\n⚠️ DATOS INVÁLIDOS\\n\");\r",
              "    console.log(\"📝 Error:\", jsonData.message);\r",
              "    console.log(\"\\n💡 Verifica que enviaste email y password\");\r",
              "    \r",
              "} else {\r",
              "    console.log(\"\\n⚠️ ERROR INESPERADO\\n\");\r",
              "    console.log(\"Status Code:\", pm.response.code);\r",
              "    console.log(\"Respuesta:\", jsonData);\r",
              "}\r",
              "\r",
              "console.log(\"\\n\" + \"=\".repeat(60));\r",
              "\r",
              "// ============================================\r",
              "// ESTADÍSTICAS\r",
              "// ============================================\r",
              "\r",
              "console.log(\"\\n📊 ESTADÍSTICAS DE LA PETICIÓN:\");\r",
              "console.log(\"   • Tiempo de respuesta:\", pm.response.responseTime, \"ms\");\r",
