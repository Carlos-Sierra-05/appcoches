    {
      "name": "REGISTRO",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Test 1: Verificar que el registro fue exitoso (201) o usuario ya existe (400)\r",
              "pm.test(\"✅ Status code es 201 (éxito) o 400 (ya existe)\", function () {\r",
              "    pm.expect([201, 400]).to.include(pm.response.code);\r",
              "});\r",
              "\r",
              "// Test 2: Verificar estructura de respuesta\r",
              "pm.test(\"✅ Respuesta tiene campo 'success'\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData).to.have.property('success');\r",
              "    pm.expect(jsonData).to.have.property('message');\r",
              "});\r",
              "\r",
              "// Test 3: Si fue exitoso, verificar que devuelve user_id\r",
              "if (pm.response.code === 201) {\r",
              "    pm.test(\"✅ Registro exitoso - Devuelve user_id\", function () {\r",
              "        var jsonData = pm.response.json();\r",
              "        pm.expect(jsonData.success).to.be.true;\r",
              "        pm.expect(jsonData).to.have.property('user_id');\r",
              "        pm.expect(jsonData.user_id).to.be.a('number');\r",
              "        \r",
              "        // Guardar user_id para usar después\r",
              "        pm.environment.set('last_user_id', jsonData.user_id);\r",
              "    });\r",
              "    \r",
              "    pm.test(\"✅ Mensaje de éxito correcto\", function () {\r",
              "        var jsonData = pm.response.json();\r",
              "        pm.expect(jsonData.message.toLowerCase()).to.include('exitoso');\r",
              "    });\r",
              "}\r",
              "\r",
              "// Test 4: Si falló, verificar el motivo\r",
              "if (pm.response.code === 400) {\r",
              "    pm.test(\"⚠️ Registro fallido - Verificar motivo\", function () {\r",
              "        var jsonData = pm.response.json();\r",
              "        pm.expect(jsonData.success).to.be.false;\r",
              "        console.log(\"❌ Motivo del fallo:\", jsonData.message);\r",
              "    });\r",
              "}\r",
              "\r",
              "// Test 5: Verificar que NO devuelve la contraseña\r",
              "pm.test(\"✅ Respuesta NO contiene la contraseña\", function () {\r",
              "    var responseBody = pm.response.text().toLowerCase();\r",
              "    pm.expect(responseBody).to.not.include('carlos2024'.toLowerCase());\r",
              "});\r",
              "\r",
              "// Test 6: Verificar formato JSON\r",
              "pm.test(\"✅ Respuesta es JSON válido\", function () {\r",
              "    pm.response.to.be.json;\r",
              "});\r",
              "\r",
              "// ============================================\r",
              "// LOGS EN CONSOLA\r",
              "// ============================================\r",
              "\r",
              "console.log(\"=\".repeat(60));\r",
              "console.log(\"👤 REGISTRO DE NUEVO USUARIO\");\r",
              "console.log(\"=\".repeat(60));\r",
              "\r",
              "var jsonData = pm.response.json();\r",
              "\r",
              "if (pm.response.code === 201) {\r",
              "    console.log(\"\\n✅ REGISTRO EXITOSO\\n\");\r",
              "    console.log(\"📧 Email:\", pm.request.body.raw ? JSON.parse(pm.request.body.raw).email : 'N/A');\r",
              "    console.log(\"👤 Nombre:\", pm.request.body.raw ? JSON.parse(pm.request.body.raw).nombre : 'N/A');\r",
              "    console.log(\"🆔 User ID:\", jsonData.user_id);\r",
              "    console.log(\"📝 Mensaje:\", jsonData.message);\r",
              "    console.log(\"\\n💡 Ahora puedes hacer login con estas credenciales\");\r",
              "} else if (pm.response.code === 400) {\r",
              "    console.log(\"\\n❌ REGISTRO FALLIDO\\n\");\r",
              "    console.log(\"📝 Motivo:\", jsonData.message);\r",
              "    console.log(\"\\n💡 Posibles causas:\");\r",
              "    console.log(\"   • Email ya registrado\");\r",
              "    console.log(\"   • Email con formato inválido\");\r",
              "    console.log(\"   • Contraseña no cumple requisitos\");\r",
              "    console.log(\"   • Campos vacíos o faltantes\");\r",
              "} else {\r",
              "    console.log(\"\\n⚠️ ERROR INESPERADO\\n\");\r",
              "    console.log(\"Status Code:\", pm.response.code);\r",
              "    console.log(\"Respuesta:\", jsonData);\r",
              "}\r",
              "\r",
              "console.log(\"=\".repeat(60));\r",
              "\r",
              "// ============================================\r",
              "// VALIDACIONES EXTRA\r",
              "// ============================================\r",
              "\r",
              "// Validar formato de email\r",
              "var requestBody = pm.request.body.raw ? JSON.parse(pm.request.body.raw) : {};\r",
              "if (requestBody.email) {\r",
              "    var emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\r",
              "    if (!emailRegex.test(requestBody.email)) {\r",
              "        console.log(\"\\n⚠️ ADVERTENCIA: Email parece tener formato inválido\");\r",
              "    }\r",
              "}\r",
              "\r",
              "// Validar contraseña\r",
              "if (requestBody.password) {\r",
              "    var password = requestBody.password;\r",
              "    var warnings = [];\r",
              "    \r",
              "    if (password.length < 8) {\r",
              "        warnings.push(\"Contraseña debe tener al menos 8 caracteres\");\r",
              "    }\r",
              "    if (!/[A-Z]/.test(password)) {\r",
              "        warnings.push(\"Contraseña debe tener al menos una mayúscula\");\r",
              "    }\r",
              "    if (!/[a-z]/.test(password)) {\r",
              "        warnings.push(\"Contraseña debe tener al menos una minúscula\");\r",
              "    }\r",
              "    if (!/[0-9]/.test(password)) {\r",
              "        warnings.push(\"Contraseña debe tener al menos un número\");\r",
              "    }\r",
              "    \r",
              "    if (warnings.length > 0) {\r",
              "        console.log(\"\\n⚠️ ADVERTENCIAS DE CONTRASEÑA:\");\r",
              "        warnings.forEach(w => console.log(\"   •\", w));\r",
              "    }\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
